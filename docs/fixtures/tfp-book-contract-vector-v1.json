    "mapping": "single sequence => seq=S, prev_seq=P; range => seq_start=A, seq_end=B, seq=B, prev_seq=P; snapshot seed => bridge_kind=seed; snapshot-after-gap recovery is recorded but does not erase prior quarantine",
    "bridge_conditions": [
      "single update requires prev_seq==last_seq or seq==last_seq+1 when prev_seq is null",
      "range requires prev_seq==last_seq and seq_start==last_seq+1",
      "snapshot-after-snapshot seeds; first post-snapshot update must satisfy the same bridge rule"
    ],
    "unknown_source": "canonicalize only when source supplies unambiguous values; otherwise seq/prev_seq/range are null, provenance records source mapping, status=unsequenced; inference is forbidden"
  },
